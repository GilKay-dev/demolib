PORT=4000
CLIENT_URL=http://localhost:5173

# Supabase Postgres (project library-lending, ref fjhjphkjtpabrwwzptjl)
# Pooler (transaction mode, port 6543) cho app; direct/session (port 5432) cho Prisma CLI
DATABASE_URL="postgresql://postgres.fjhjphkjtpabrwwzptjl:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.fjhjphkjtpabrwwzptjl:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

JWT_SECRET=change-me
JWT_EXPIRES_IN=24h

# Supabase Storage (ảnh bìa sách) — dùng service role key, chỉ ở backend
SUPABASE_URL=https://fjhjphkjtpabrwwzptjl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Giới hạn đăng nhập/đổi mật khẩu sai trong 15 phút (mặc định 10 / 5)
# LOGIN_RATE_LIMIT=10
# PASSWORD_RATE_LIMIT=5
# Số lớp reverse proxy phía trước (Vercel: 1) để rate limit lấy đúng IP; bỏ trống khi chạy local
# TRUST_PROXY=1
